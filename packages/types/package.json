{
  "name": "@stellar-save/types",
  "version": "0.1.0",
  "description": "Zero-dependency shared TypeScript types for Stellar-Save backend, frontend, and mobile",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": ["src"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^3.2.6"
  },
  "license": "MIT"
}
